-- Capture agent (spec 2026-10-17-agentic-hisaab-design): messages are queued for a batched agent instead of
-- being parsed by templates/thresholds. QUEUED = waiting for the agent; PENDING = parked on an agent question.
ALTER TABLE capture_inbox ADD COLUMN question_id TEXT;
-- Agent runs that left this message undecided; at 3 it becomes a question for the user.
ALTER TABLE capture_inbox ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;

-- Daily cap on AI calls: count for agent_calls_day (local YYYY-MM-DD), reset when the day changes.
ALTER TABLE capture_config ADD COLUMN agent_calls_day TEXT;
ALTER TABLE capture_config ADD COLUMN agent_calls_count INTEGER NOT NULL DEFAULT 0;

-- What the agent asks when it can't decide. options = JSON array of quick answers.
CREATE TABLE agent_question (
    id          TEXT NOT NULL PRIMARY KEY,
    question    TEXT NOT NULL,
    options     TEXT NOT NULL DEFAULT '[]',
    status      TEXT NOT NULL DEFAULT 'OPEN',
    answer      TEXT,
    created_at  INTEGER NOT NULL,
    answered_at INTEGER
);
CREATE INDEX idx_agent_question_status ON agent_question(status, created_at);
CREATE INDEX idx_capture_question ON capture_inbox(question_id);

-- Facts the agent learned ("alerts@citybank.com is the City Bank card"), sent with every batch.
CREATE TABLE agent_memory (
    id         TEXT NOT NULL PRIMARY KEY,
    fact       TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

-- Hand the rule-based engine's leftovers to the agent: everything waiting in Review is re-read, and every
-- sender the user mapped to an account becomes a memory instead of a rule.
UPDATE capture_inbox SET status = 'QUEUED' WHERE status = 'PENDING';
INSERT INTO agent_memory(id, fact, created_at)
SELECT 'sender-' || s.id, 'Messages from ' || s.sender_id || ' are for the account "' || a.name || '"', s.created_at
FROM sender_registry s JOIN account a ON a.id = s.account_id;
