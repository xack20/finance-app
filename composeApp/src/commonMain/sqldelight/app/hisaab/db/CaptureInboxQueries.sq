insertCandidate:
INSERT OR IGNORE INTO capture_inbox(
    id, received_at, channel, sender, raw_body, dedup_hash, status, confidence,
    parsed_by, model, parse_error, amount, direction, currency, balance_after,
    ref_no, proposed_account_id, proposed_category_id, proposed_merchant, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

findByDedupHash:
SELECT * FROM capture_inbox WHERE dedup_hash = ? LIMIT 1;

getById:
SELECT * FROM capture_inbox WHERE id = ? LIMIT 1;

observePending:
SELECT * FROM capture_inbox WHERE status = 'PENDING' ORDER BY received_at DESC;

observeRecent:
SELECT * FROM capture_inbox ORDER BY received_at DESC LIMIT ?;

observePendingCount:
SELECT COUNT(*) FROM capture_inbox WHERE status = 'PENDING';

updateStatus:
UPDATE capture_inbox SET status = ? WHERE id = ?;

-- Blanks only the SMS body content; sender (bank shortcode) is retained for provenance.
purgeRaw:
UPDATE capture_inbox SET raw_body = '' WHERE id = ?;

-- ---- capture agent ----
-- Messages received since :recentSince first (today's payment shouldn't wait behind a history import), then oldest.
nextQueued:
SELECT * FROM capture_inbox WHERE status = 'QUEUED'
ORDER BY (received_at >= :recentSince) DESC, received_at ASC
LIMIT :limit;

observeQueuedCount:
SELECT COUNT(*) FROM capture_inbox WHERE status = 'QUEUED';

markDecided:
UPDATE capture_inbox SET status = ?, parse_error = ? WHERE id = ?;

parkOnQuestion:
UPDATE capture_inbox SET status = 'PENDING', question_id = ? WHERE id = ?;

bumpAttempts:
UPDATE capture_inbox SET attempts = attempts + 1 WHERE id = ?;

forQuestion:
SELECT * FROM capture_inbox WHERE question_id = ? ORDER BY received_at ASC;

requeueQuestion:
UPDATE capture_inbox SET status = 'QUEUED', attempts = 0 WHERE question_id = ? AND status = 'PENDING';

dismissQuestion:
UPDATE capture_inbox SET status = 'DISMISSED', parse_error = 'user: not a payment'
WHERE question_id = ? AND status = 'PENDING';

linkPosted:
UPDATE capture_inbox SET status = 'AUTO_POSTED', parse_error = NULL, amount = ?, direction = ?,
    proposed_account_id = ?, proposed_category_id = ?, proposed_merchant = ?, model = ?
WHERE id = ?;

-- Open agent questions (each parks at least one message), for the Today banner.
observeOpenQuestionCount:
SELECT COUNT(DISTINCT question_id) FROM capture_inbox WHERE status = 'PENDING' AND question_id IS NOT NULL;

-- "Skipped by Hisaab": what the agent (or a copy rule) dismissed, newest first.
observeRecentlySkipped:
SELECT * FROM capture_inbox WHERE status = 'DISMISSED' ORDER BY received_at DESC LIMIT ?;

requeueWithQuestion:
UPDATE capture_inbox SET status = 'QUEUED', attempts = 0, question_id = ? WHERE id = ?;
