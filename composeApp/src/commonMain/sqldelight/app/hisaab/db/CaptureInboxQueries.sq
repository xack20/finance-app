insertCandidate:
INSERT OR IGNORE INTO capture_inbox(
    id, received_at, channel, sender, raw_body, dedup_hash, status, confidence,
    parsed_by, model, parse_error, amount, direction, currency, balance_after,
    ref_no, proposed_account_id, proposed_category_id, proposed_merchant, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

findByDedupHash:
SELECT * FROM capture_inbox WHERE dedup_hash = ? LIMIT 1;

getById:
SELECT * FROM capture_inbox WHERE id = ? LIMIT 1;

-- Cross-channel duplicates (one payment arriving by SMS + email + notification). Dismissed rows don't count.
findLiveByRefNo:
SELECT * FROM capture_inbox WHERE lower(trim(ref_no)) = ? AND status != 'DISMISSED' LIMIT 1;

waitingSendersWithoutAccount:
SELECT DISTINCT sender FROM capture_inbox WHERE status = 'PENDING' AND proposed_account_id IS NULL;

findPendingWithoutAccount:
SELECT * FROM capture_inbox WHERE sender = ? AND status = 'PENDING' AND proposed_account_id IS NULL;

setProposedAccount:
UPDATE capture_inbox SET proposed_account_id = ? WHERE id = ?;

getLive:
SELECT * FROM capture_inbox WHERE status != 'DISMISSED' ORDER BY received_at ASC;

markDuplicate:
UPDATE capture_inbox SET status = 'DISMISSED', parse_error = 'duplicate' WHERE id = ?;

findLiveNear:
SELECT * FROM capture_inbox
WHERE amount = ? AND direction = ? AND channel != ? AND received_at BETWEEN ? AND ? AND status != 'DISMISSED';

observePending:
SELECT * FROM capture_inbox WHERE status = 'PENDING' ORDER BY received_at DESC;

observeRecent:
SELECT * FROM capture_inbox ORDER BY received_at DESC LIMIT ?;

observePendingCount:
SELECT COUNT(*) FROM capture_inbox WHERE status = 'PENDING';

updateStatus:
UPDATE capture_inbox SET status = ? WHERE id = ?;

-- Blanks only the SMS body content; sender (bank shortcode) is retained for provenance.
purgeRaw:
UPDATE capture_inbox SET raw_body = '' WHERE id = ?;
