// Release base xcconfig for the iosApp target (committed).
// Chains the two configs the target needs:
//  1) CocoaPods (SQLCipher link/header/search-path settings) — generated by `pod install`.
//  2) Secrets.xcconfig (Supabase keys) — gitignored; copy from Secrets.xcconfig.example.
// Both use `#include?` (optional) so `xcodegen generate` works before pods are installed / on a
// fresh clone without secrets.
#include? "Pods/Target Support Files/Pods-iosApp/Pods-iosApp.release.xcconfig"
#include? "Secrets.xcconfig"

// SECURITY: the build-config Gemini key is a DEBUG/dev convenience only. Blank it for Release so a
// distributable build never embeds a billable third-party API key in Info.plist — and so the
// consent bypass + apiKey fallback that depend on it stay OFF in Release. On a release build users
// bring their own key in-app (-> Keychain) and go through the explicit cloud-consent flow.
GEMINI_API_KEY =
