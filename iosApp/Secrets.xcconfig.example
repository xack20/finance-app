// Template for iOS Supabase config. Copy to the gitignored Secrets.xcconfig and fill in your values:
//     cp iosApp/Secrets.xcconfig.example iosApp/Secrets.xcconfig
//
// These mirror local.properties (supabase.url / supabase.anon_key) used by the Android build, and are
// substituted into Info.plist (SUPABASE_URL / SUPABASE_ANON_KEY) → read by SupabaseConfig.kt at runtime.
//
// NOTE: the `/$()/` escapes xcconfig's `//` comment syntax inside the URL — keep that form, or the URL
// silently truncates at "https:".
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
